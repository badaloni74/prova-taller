    {
      "name": "_setup (fixtures compartidas)",
      "item": [
        {
          "name": "_setup · Obtener dos vehículos de clientes distintos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/vehicles",
              "host": [
                "{{baseUrl}}/vehicles"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"hay al menos dos vehículos en la base sembrada\", () => {",
                  "  const vehicles = pm.response.json();",
                  "  pm.expect(vehicles.length).to.be.at.least(2);",
                  "});",
                  "const vehicles = pm.response.json();",
                  "const vA = vehicles[0];",
                  "const vB = vehicles.find(v => v.client_id !== vA.client_id);",
                  "pm.test(\"los dos vehículos elegidos pertenecen a clientes distintos\", () => {",
                  "  pm.expect(vB, \"no se ha encontrado un segundo vehículo de otro cliente\").to.not.be.undefined;",
                  "});",
                  "pm.environment.set(\"vehicleAId\", vA.id);",
                  "pm.environment.set(\"clientAId\", vA.client_id);",
                  "pm.environment.set(\"vehicleBId\", vB.id);",
                  "pm.environment.set(\"clientBId\", vB.client_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "_setup · Obtener una pieza con stock (Filtre d'oli)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/peces",
              "host": [
                "{{baseUrl}}/peces"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const peces = pm.response.json();",
                  "const peca = peces.find(p => p.referencia === 'FO-100') || peces[0];",
                  "pm.test(\"existe al menos una pieza con stock positivo\", () => {",
                  "  pm.expect(peca.estoc).to.be.above(0);",
                  "});",
                  "pm.environment.set(\"pecaId\", peca.id);",
                  "pm.environment.set(\"pecaPreu\", peca.preu);",
                  "pm.environment.set(\"pecaEstocInicial\", peca.estoc);"
                ]
              }
            }
          ]
        }
      ]
