        {
          "name": "_setup · Añadir línea de mano de obra al albarán de TC-041",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/albarans/{{albaran041Id}}/linies",
              "host": [
                "{{baseUrl}}/albarans/{{albaran041Id}}/linies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipus\": \"ma_obra\",\n  \"descripcio\": \"Revisió general\",\n  \"quantitat\": 1,\n  \"preu\": 35\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"el albarán de partida queda con exactamente dos líneas\", () => {",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "  pm.expect(body.linies).to.have.lengthOf(2);",
                  "});",
                  "const base = body.linies.reduce((s, l) => s + Number(l.quantitat) * Number(l.preu), 0);",
                  "pm.environment.set(\"baseEsperada041\", base.toFixed(2));",
                  "pm.environment.set(\"lineaPecaId041\", body.linies.find(l => l.tipus === 'peca').id);",
                  "pm.environment.set(\"lineaMaObraId041\", body.linies.find(l => l.tipus === 'ma_obra').id);"
                ]
              }
            }
          ]
        },
