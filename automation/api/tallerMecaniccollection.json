                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"TC-041 · efecto lateral: el albarán sigue con exactamente sus dos líneas de partida\", () => {",
                  "  pm.expect(body.linies).to.have.lengthOf(2);",
                  "  pm.expect(body.linies.some(l => l.tipus === 'recanvi')).to.eql(false);",
                  "});",
                  "pm.test(\"TC-041 · efecto lateral: la base no ha cambiado\", () => {",
                  "  const base = body.linies.reduce((s, l) => s + Number(l.quantitat) * Number(l.preu), 0);",
