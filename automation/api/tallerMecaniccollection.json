          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"la línea de pieza se registra con el precio de catálogo\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "  const linia = body.linies.find(l => l.tipus === 'peca');",
                  "  pm.expect(Number(linia.preu)).to.eql(Number(pm.environment.get(\"pecaPreu\")));",
                  "});"
                ]
              }
            }
          ]
